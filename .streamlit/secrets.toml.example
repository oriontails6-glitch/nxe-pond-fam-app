# .streamlit/secrets.toml.example
# Copy this file to .streamlit/secrets.toml and fill in your private values.
# NEVER commit .streamlit/secrets.toml to git!

# Supabase Project Credentials (from Project Settings > API)
# Use the service_role key (secret), NOT the public anon key.
SUPABASE_URL = "https://your-project-ref.supabase.co"
SUPABASE_SERVICE_KEY = "your-service-role-key-here"

# Alliance secret passphrase required alongside Governor ID to log in
JOIN_CODE = "NXEHALLOWEEN2026"

# Secret key used for signing session tokens (HMAC-SHA256) for mobile reload persistence
SESSION_SECRET = "change-me-to-a-long-random-string-at-least-32-chars"

# Test Mode flag (set to true to enable phase override testing in admin panel, false for launch)
TEST_MODE = true

# 4 Admin Credentials (username / password pairs)
[ADMIN_USERS]
admin1 = "ChangeMeAdminPass1!"
admin2 = "ChangeMeAdminPass2!"
admin3 = "ChangeMeAdminPass3!"
admin4 = "ChangeMeAdminPass4!"
